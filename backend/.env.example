DATABASE_URL=postgresql://user:password@localhost:5432/animalia_db
SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Render persistent disk — mount at /var/data/uploads and set:
# UPLOADS_DIR=/var/data/uploads

# First-run admin (created only when no users exist). Override on Render:
# ADMIN_PASSWORD=your-secure-password
AUTO_CREATE_ADMIN=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@animalia.org
ADMIN_FULL_NAME=Admin User

# Google Calendar visit booking (optional)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REFRESH_TOKEN=...
# GOOGLE_CALENDAR_ID=primary
# VISIT_TIMEZONE=Asia/Dubai
# VISIT_STAFF_ATTENDEES=extra1@example.com,extra2@example.com

# Visit request email alerts (optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=Animalia <you@gmail.com>
# VISIT_REQUEST_NOTIFY_EMAIL=staff@animalia.org,team@animalia.org
